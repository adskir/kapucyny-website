---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ "/" | absUrl(settings.site_url) }}</loc>
  </url>
{%- for item in collections.all %}
{%- if item.url and not item.data.noindex and not item.data.sitemapExclude %}
  <url>
    <loc>{{ item.url | absUrl(settings.site_url) }}</loc>
    {%- if item.data.layout == "novasc.njk" %}
    <lastmod>{{ item.date | isoDate }}</lastmod>
    {%- endif %}
  </url>
{%- endif %}
{%- endfor %}
</urlset>
