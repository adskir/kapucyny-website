# Рэдырэкты са старога сайта WordPress (kapucyny.by, 2014–2021) на новы сайт.
# Старыя адрасы былі выгляду /?page_id=405, /?p=5164, /index.php/?cat=4 і г.д.
# Згенеравана з базы старога сайта (72 старонкі, 152 навіны, 54 галерэі, форум).
# Знак ? у канцы мэты выдаляе стары query string.

ErrorDocument 404 /404.html

RewriteEngine On

# ── 0. Адзіны адрас сайта: https://kapucyny.by (без www, толькі https) ──
# Папка .well-known патрэбна для аўтаматычнага падаўжэння SSL — яе не чапаем.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://kapucyny.by/$1 [R=301,L]

# ── 1. Старонкі (page_id / p) → адпаведныя старонкі новага сайта ──
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(15|56|95|413|415|417|684|688|690)(&|$)
RewriteRule ^(index\.php/?)?$ /svyaty-francishak/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(1024)(&|$)
RewriteRule ^(index\.php/?)?$ /bibliyateka/regula-francishkanskaga-ordena-sviecikh/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(180|355|357|359)(&|$)
RewriteRule ^(index\.php/?)?$ /braty-kapucyny/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(402|645)(&|$)
RewriteRule ^(index\.php/?)?$ /bibliyateka/pravila-sv-francishka/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(182|1688|1748|2172|3041|4103)(&|$)
RewriteRule ^(index\.php/?)?$ /prysutnasc-kapucynau/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(405|539|543)(&|$)
RewriteRule ^(index\.php/?)?$ /bibliyateka/gistoryja-kapucynau-na-belaruskih-zemlyah/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(422|426)(&|$)
RewriteRule ^(index\.php/?)?$ /braty-kapucyny/braty-jakija-sluzhac-u-belarusi/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(1692)(&|$)
RewriteRule ^(index\.php/?)?$ /minsk/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(1701)(&|$)
RewriteRule ^(index\.php/?)?$ /smalyavichy/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(1911)(&|$)
RewriteRule ^(index\.php/?)?$ /dokshytsy/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(2192)(&|$)
RewriteRule ^(index\.php/?)?$ /maladzyechna/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(2201)(&|$)
RewriteRule ^(index\.php/?)?$ /lipnishki/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(5028)(&|$)
RewriteRule ^(index\.php/?)?$ /vilnius/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(184|434|436|438)(&|$)
RewriteRule ^(index\.php/?)?$ /byc-kapucynam/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(432)(&|$)
RewriteRule ^(index\.php/?)?$ /byc-kapucynam/yak-stac-kapucynam/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(307|656|657|661|665|668|1009|1154|1175|2949|4227|5040)(&|$)
RewriteRule ^(index\.php/?)?$ /bibliyateka/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(2|960)(&|$)
RewriteRule ^(index\.php/?)?$ /galereya/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(317)(&|$)
RewriteRule ^(index\.php/?)?$ /kantakty/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(576)(&|$)
RewriteRule ^(index\.php/?)?$ /spasylki/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(1439|2329)(&|$)
RewriteRule ^(index\.php/?)?$ https://sacris.by/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(724|818|872|947|3323|4640|4780|4795|5083|10226)(&|$)
RewriteRule ^(index\.php/?)?$ /naviny/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=(324|326|807|909|982|1015)(&|$)
RewriteRule ^(index\.php/?)?$ /? [R=301,L]

# ── 2. Галерэі → /galereya/ ──
RewriteCond %{QUERY_STRING} (^|&)(gab_gallery|gallery-cat|gallery-tag)= [OR]
RewriteCond %{QUERY_STRING} (^|&)p=(634|990|992|996|998|1000|1133|1172|1188|1416|1497|1532|1579|1591|1615|1625|1669|1715|1721|1757|1807|1945|1955|2001|2030|2240|2274|2342|2479|2632|2644|2746|2765|3064|3210|3312|3391|3626|3889|3955|3976|4032|4058|4061|4079|4095|4358|4679|4761|4861|5104|10406|10512|10581|10745)(&|$)
RewriteRule ^(index\.php/?)?$ /galereya/? [R=301,L]

# ── 3. Навіны, рубрыкі, архівы, RSS → /naviny/ ──
RewriteCond %{QUERY_STRING} (^|&)(p|cat|tag|m|feed|paged)=
RewriteRule ^(index\.php/?)?$ /naviny/? [R=301,L]

# ── 4. Форум, пошук, укладанні і іншае → галоўная ──
RewriteCond %{QUERY_STRING} (^|&)(page_id|topic|forum|reply|topic-tag|view|attachment_id|s|author|bbp_search|action)=
RewriteRule ^(index\.php/?)?$ /? [R=301,L]

# ── 5. Службовыя адрасы WordPress → галоўная ──
RewriteRule ^(wp-login\.php|wp-admin/?|index\.php/?)$ /? [R=301,L]
