---
layout: base.njk
---
<section class="page-hero">
  <h1>{{ title }}</h1>
  <div class="breadcrumb">Прысутнасць капуцынаў</div>
</section>

<section>
  <div class="article">
    {% if image %}<img src="{{ image }}" alt="{{ title }}">{% endif %}

    {{ content | safe }}

    <dl class="loc-meta">
      {% if address %}<dt>Адрас</dt><dd>{{ address }}</dd>{% endif %}
      {% if correspondence_address %}<dt>Для карэспандэнцыі</dt><dd>{{ correspondence_address }}</dd>{% endif %}
      {% if phone %}<dt>Тэлефон</dt><dd><a href="tel:{{ phone }}">{{ phone }}</a></dd>{% endif %}
      {% if email %}<dt>E-mail</dt><dd><a href="mailto:{{ email }}">{{ email }}</a></dd>{% endif %}
      {% if facebook %}<dt>Facebook</dt><dd><a href="{{ facebook }}" target="_blank" rel="noopener">{{ facebook }}</a></dd>{% endif %}
      {% if website %}<dt>Сайт прыхода</dt><dd><a href="{{ website }}" target="_blank" rel="noopener">{{ website }}</a></dd>{% endif %}
      {% if services and services.length %}
        <dt>Расклад набажэнстваў</dt>
        <dd>
          {% for s in services %}{{ s.label }}: {{ s.time }}<br>{% endfor %}
        </dd>
      {% endif %}
    </dl>

    <div style="margin-top:36px;">
      <a href="/" class="btn-outline">← Галоўная</a>
    </div>
  </div>
</section>
