<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-col">
      <h4>Навігацыя</h4>
      <a href="/svyaty-francishak/">Святы Францішак</a>
      <a href="/braty-kapucyny/">Браты Капуцыны</a>
