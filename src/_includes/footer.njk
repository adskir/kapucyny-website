<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-contacts">
      <a href="mailto:{{ settings.curia.email }}" class="footer-contact-item">{{ settings.curia.email }}</a>
      <span class="footer-sep" aria-hidden="true"></span>
      <a href="tel:{{ settings.curia.phone }}" class="footer-contact-item">{{ settings.curia.phone }}</a>
      <span class="footer-sep" aria-hidden="true"></span>
      <span class="footer-contact-item footer-address">{{ settings.curia.address }}</span>
    </div>
    <div class="footer-social">
      {% if settings.facebook_url %}
      <a href="{{ settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M13.5 9H15.5V6.2H13.3C11.15 6.2 9.4 7.95 9.4 10.1V12H7.5V15H9.4V21H12.4V15H14.5L15 12H12.4V10.4C12.4 9.65 12.85 9 13.5 9Z" fill="currentColor"/></svg>
      </a>
      {% endif %}
      {% if settings.instagram_url %}
      <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5.5" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/><circle cx="17.3" cy="6.7" r="1.15" fill="currentColor"/></svg>
      </a>
      {% endif %}
      {% if settings.youtube_url %}
      <a href="{{ settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2.5" y="5.5" width="19" height="13" rx="3.5" stroke="currentColor" stroke-width="1.7"/><path d="M10.5 9.5L15 12L10.5 14.5V9.5Z" fill="currentColor"/></svg>
      </a>
      {% endif %}
      {% if settings.whatsapp_url %}
      <a href="{{ settings.whatsapp_url }}" target="_blank" rel="noopener" aria-label="WhatsApp">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.48 2 2 6.48 2 12C2 13.85 2.5 15.58 3.35 17.06L2 22L7.06 20.67C8.53 21.5 10.21 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM17.2 16.2C16.98 16.82 15.92 17.4 15.43 17.44C14.98 17.48 14.53 17.5 13.98 17.35C13.65 17.26 13.22 17.11 12.68 16.88C10.38 15.89 8.88 13.58 8.76 13.42C8.65 13.27 7.82 12.17 7.82 11.04C7.82 9.91 8.42 9.36 8.63 9.14C8.84 8.91 9.09 8.85 9.24 8.85C9.39 8.85 9.54 8.85 9.67 8.86C9.81 8.87 9.99 8.81 10.17 9.24C10.36 9.7 10.82 10.82 10.88 10.94C10.94 11.05 10.98 11.19 10.9 11.34C10.82 11.49 10.78 11.59 10.66 11.72C10.54 11.85 10.41 12.02 10.3 12.12C10.18 12.23 10.06 12.36 10.2 12.59C10.34 12.82 10.82 13.61 11.52 14.25C12.43 15.06 13.2 15.31 13.43 15.43C13.66 15.54 13.8 15.53 13.93 15.37C14.07 15.21 14.51 14.69 14.67 14.46C14.82 14.23 14.97 14.27 15.17 14.35C15.37 14.43 16.45 14.95 16.67 15.06C16.89 15.17 17.04 15.22 17.09 15.31C17.14 15.4 17.14 15.81 16.92 16.43L17.2 16.2Z" fill="currentColor"/></svg>
      </a>
      {% endif %}
    </div>
  </div>
  <div class="footer-bottom">
    <img class="tau" src="/images/uploads/logo-capucyny.png" alt="">
    {{ settings.footer_copyright }}
  </div>
</footer>

<script src="/js/main.js"></script>
